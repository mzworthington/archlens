{
  "name": "hype-machine",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source self-learning hype DJ research kit",
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "pnpm --filter @hype-machine/core build && pnpm --filter @hype-machine/cli build",
    "test": "pnpm --filter @hype-machine/core test",
    "typecheck": "pnpm --filter @hype-machine/core build && pnpm -r run typecheck",
    "analyze": "pnpm build && node packages/cli/dist/index.js analyze"
  },
  "engines": {
    "node": ">=20"
  }
}
