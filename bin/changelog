#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

GIT_CLIFF="$ROOT/app/node_modules/.bin/git-cliff"

case "${1:-}" in
  --check)
    "$GIT_CLIFF" -c cliff.toml -o CHANGELOG.md
    git diff --exit-code CHANGELOG.md
    ;;
  '')
    exec "$GIT_CLIFF" -c cliff.toml -o CHANGELOG.md
    ;;
  *)
    exec "$GIT_CLIFF" -c cliff.toml "$@"
    ;;
esac
