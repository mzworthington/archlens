#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

case "${1:-}" in
  --check)
    node "$ROOT/bin/changelog-render.mjs"
    git diff --exit-code CHANGELOG.md
    ;;
  '')
    exec node "$ROOT/bin/changelog-render.mjs"
    ;;
  *)
    exec "$ROOT/app/node_modules/.bin/git-cliff" -c cliff.toml "$@"
    ;;
esac
