config:
  archlens-cloudflare:apexDomain: archlens.dev
  archlens-cloudflare:catalogBucketName: archlens-blueprint-catalog
  archlens-cloudflare:catalogDomain: blueprints.archlens.dev
  archlens-cloudflare:pagesProjectName: archlens
  archlens-cloudflare:wwwDomain: www.archlens.dev
  archlens-cloudflare:collabWorkerName: archlens-collab
  archlens-cloudflare:collabDomain: collab.archlens.dev
  # Guide GIFs. Defaults in index.ts match these; override only to rename the bucket or hostname.
  archlens-cloudflare:docsMediaBucketName: archlens-docs-media
  archlens-cloudflare:docsMediaDomain: media.archlens.dev
  # accountId, zoneId, and cloudflare:apiToken are set by bin/setup-cloudflare-hosting.sh
  # (stored in Pulumi Cloud + local Pulumi.prod.yaml, which is gitignored)
