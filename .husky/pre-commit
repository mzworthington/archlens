STAGED=$(git diff --cached --name-only)

if echo "$STAGED" | grep -qE '^cli/'; then
  echo "Skipping Rust checks - experimental cli/ tree is unmaintained and not part of CI."
fi

# Fail if Zod → JSON Schema artifacts are stale when core (or generator) changes.
if echo "$STAGED" | grep -qE '^app/packages/core/'; then
  echo "Core package staged - checking schemas/blueprint.schema.json is up to date..."
  (cd app && pnpm generate:schema -- --check) || {
    echo "Schema out of date. Run: cd app && pnpm generate:schema"
    exit 1
  }
fi

# Go resilience engine: fmt, vet, and tests.
if echo "$STAGED" | grep -qE '^resilience-engine/.*\.go$'; then
  echo "Resilience engine Go source staged - running Go checks..."
  (cd resilience-engine && make check test) || exit 1
fi

# CI runs format:check on app + repo docs/README. Keep the hook in sync.
NEEDS_APP_CHECKS=false
NEEDS_DOCS_FORMAT=false

if echo "$STAGED" | grep -qE '^app/'; then
  NEEDS_APP_CHECKS=true
fi

if echo "$STAGED" | grep -qE '^docs/|(^|/)[^/]+\.md$'; then
  NEEDS_DOCS_FORMAT=true
fi

if [ "$NEEDS_APP_CHECKS" = true ] || [ "$NEEDS_DOCS_FORMAT" = true ]; then
  echo "Detected staged app/docs changes. Running PNPM checks..."
  cd app
  pnpm exec lint-staged
  if [ "$NEEDS_APP_CHECKS" = true ]; then
    pnpm run lint
    pnpm run typecheck
    pnpm knip
    pnpm vitest run --changed
  fi
  cd ..
fi

# Prose lint for staged Markdown. CI enforces the same config when Vale is absent locally.
docs=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' || true)

if [ -n "$docs" ]; then
  echo "Running Vale against staged documentation..."
  if command -v vale >/dev/null 2>&1; then
    printf '%s\n' "$docs" | tr '\n' '\0' | xargs -0 vale || {
      echo "Vale linting failed. Fix style issues before committing."
      exit 1
    }
  elif command -v mise >/dev/null 2>&1; then
    printf '%s\n' "$docs" | tr '\n' '\0' | xargs -0 mise exec -- vale || {
      echo "Vale linting failed. Fix style issues before committing."
      exit 1
    }
  else
    echo "Vale is not installed; prose lint skipped. CI still runs it."
  fi
fi
