{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "exports": "error",
    "types": "error"
  },
  "ignoreDependencies": [
    "lint-staged",
    "@types/*",
    "git-cliff",
    "tree-sitter-wasms",
    "@tree-sitter-grammars/tree-sitter-hcl"
  ],
  "ignoreBinaries": ["make", "vhs"],
  "ignore": ["scripts/deploySmoke/**"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "workspaces": {
    "packages/canvas": {
      "entry": ["src/preview/webview.tsx"],
      "project": ["src/**/*.{ts,tsx,css}", "tests/**/*.ts"],
      "paths": {
        "@docs/*": ["../../../docs/*"]
      }
    },
    "packages/collab": {
      "project": ["src/**/*.ts"]
    },
    "packages/vscode": {
      "project": ["src/**/*.ts"]
    }
  }
}
