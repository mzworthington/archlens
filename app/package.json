{
  "name": "archlens",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @archlens/canvas dev",
    "dev:cli": "pnpm --filter @archlens/cli dev",
    "build:resilience-engine": "make -C ../resilience-engine copy-wasm",
    "build": "pnpm build:resilience-engine && pnpm --filter @archlens/canvas build && pnpm --filter @archlens/cli build",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings",
    "typecheck": "pnpm --filter @archlens/canvas exec tsc -b",
    "preview": "pnpm --filter @archlens/canvas preview",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @archlens/core test",
    "test:analysis": "pnpm --filter @archlens/analysis test",
    "test:cli": "pnpm --filter @archlens/cli test",
    "test:vhs": "pnpm --filter @archlens/cli test:vhs",
    "test:canvas": "pnpm --filter @archlens/canvas test",
    "test:app": "pnpm --filter @archlens/canvas test",
    "test:coverage": "vitest run --coverage",
    "test:ci": "GENERATE_FEATURES_UNIT=1 vitest run --coverage",
    "test:e2e": "pnpm --filter @archlens/canvas test:e2e",
    "test:a11y": "pnpm --filter @archlens/canvas test:a11y",
    "test:lighthouse": "pnpm build:resilience-engine && pnpm --filter @archlens/canvas build && pnpm --filter @archlens/canvas test:lighthouse",
    "record:docs-media": "pnpm --filter @archlens/canvas record:docs-media",
    "format:check": "prettier --config ../.prettierrc --ignore-path ../.prettierignore --check \"**/*.{ts,tsx,css,json,md}\" \"../*.md\" \"../docs/**/*.{md,ts}\"",
    "format:write": "prettier --config ../.prettierrc --ignore-path ../.prettierignore --write \"**/*.{ts,tsx,css,json,md}\" \"../*.md\" \"../docs/**/*.{md,ts}\"",
    "knip": "knip",
    "generate:schema": "tsx packages/core/scripts/generateJsonSchema.ts",
    "generate:features-unit": "GENERATE_FEATURES_UNIT=1 vitest run",
    "generate": "pnpm generate:schema && pnpm generate:features-unit && pnpm format:write && pnpm lint",
    "sync-derived": "../bin/sync-derived.sh",
    "prepare": "cd .. && husky"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "git-cliff": "^2.13.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.26.0",
    "lint-staged": "^17.0.8",
    "oxlint": "^1.74.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "~7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "x-feature-reporter": "^3.2.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "prettier --config ../.prettierrc --ignore-path ../.prettierignore --write",
      "oxlint -c .oxlintrc.json --deny-warnings"
    ],
    "**/*.{css,json,md}": [
      "prettier --config ../.prettierrc --ignore-path ../.prettierignore --write"
    ],
    "../docs/**/*.{md,ts}": [
      "prettier --config ../.prettierrc --ignore-path ../.prettierignore --write"
    ],
    "../*.md": [
      "prettier --config ../.prettierrc --ignore-path ../.prettierignore --write"
    ]
  }
}
