{
  "name": "@archlens/canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "make -C ../../../resilience-engine ensure-wasm",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test && playwright test --config playwright.remote-catalog.config.ts",
    "test:e2e:bundled": "playwright test",
    "test:e2e:remote-catalog": "playwright test --config playwright.remote-catalog.config.ts",
    "test:a11y": "playwright test a11y.spec.ts",
    "test:lighthouse": "lhci autorun",
    "lighthouse:summary": "node scripts/writeLighthouseSummary.mjs",
    "record:docs-media": "RECORD_DOCS_MEDIA=1 playwright test --config playwright.docs-media.config.ts"
  },
  "dependencies": {
    "@archlens/analysis": "workspace:*",
    "@archlens/core": "workspace:*",
    "@archlens/storage": "workspace:*",
    "@tree-sitter-grammars/tree-sitter-hcl": "1.2.0",
    "@xyflow/react": "^12.11.2",
    "d3-hierarchy": "^3.1.2",
    "dagre": "^0.8.5",
    "dexie": "^4.4.4",
    "elkjs": "^0.11.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.24.0",
    "mermaid": "^11.16.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.20.8",
    "workbox-window": "^7.4.1",
    "wouter": "^3.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/dagre": "^0.7.54",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.0.12",
    "vite-plugin-pwa": "^1.3.0"
  }
}
