# Local `pnpm dev`: Load sandbox from the hosted samples estate (Cloudflare R2).
# CORS allows http://localhost:5173 and :5188 (infra/cloudflare R2BucketCors).
# Override or clear in `.env.development.local` to force offline `/bundled-blueprints/`.
# Playwright sets this empty so e2e stays on bundled fixtures.
VITE_REMOTE_CATALOG_BASE_URL=https://blueprints.archlens.dev/estates/samples/
