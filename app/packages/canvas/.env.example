# Copy to `.env.development.local` for machine-specific overrides (gitignored by Vite convention).
# Empty value → bundled `samples/` under /bundled-blueprints/ (offline).
# VITE_REMOTE_CATALOG_BASE_URL=
VITE_REMOTE_CATALOG_BASE_URL=https://blueprints.archlens.dev/estates/samples/

# Unset → BroadcastChannel (same-origin tabs). Local Worker: ws://127.0.0.1:8787
# Production CI bakes wss://collab.archlens.dev on main.
# VITE_COLLAB_WS_URL=
