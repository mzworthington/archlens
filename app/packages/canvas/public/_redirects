# Apex is canonical.
https://www.archlens.dev/* https://archlens.dev/:splat 301

# Proxy to self so missing files 404 instead of the Pages SPA shell.
/assets/*              /assets/:splat              200
/bundled-blueprints/*  /bundled-blueprints/:splat  200
/bundled-chaos-specs/* /bundled-chaos-specs/:splat 200
/schemas/*             /schemas/:splat             200

# Pages pretty-URLs still 308 /index.html → / at the edge; this 200 rewrite
# does not disable that. Workbox rewrites precache HTML to directory URLs.
/index.html            /index.html                 200
/version.json          /version.json               200
