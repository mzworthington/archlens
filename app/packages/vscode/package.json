{
  "name": "archlens",
  "displayName": "ArchLens",
  "publisher": "mzworthington",
  "private": true,
  "version": "0.1.0",
  "description": "Preview a BlueprintSpec file beside the YAML. Generate diagram from workspace reviews Added, Changed and Removed systems before it writes.",
  "license": "MIT",
  "preview": true,
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/mzworthington/archlens"
  },
  "homepage": "https://archlens.dev",
  "bugs": {
    "url": "https://github.com/mzworthington/archlens/issues"
  },
  "qna": "https://github.com/mzworthington/archlens/discussions",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "architecture",
    "blueprint",
    "c4",
    "diagram"
  ],
  "activationEvents": [
    "onCommand:archlens.openArchitectureMap",
    "onCommand:archlens.generateFromWorkspace",
    "onCommand:archlens.compareWithScan",
    "onCommand:archlens.copyDiagram",
    "onCommand:archlens.showHotspots",
    "onLanguage:yaml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "archlens.openArchitectureMap",
        "title": "Open architecture map",
        "category": "ArchLens"
      },
      {
        "command": "archlens.generateFromWorkspace",
        "title": "Generate diagram from workspace",
        "category": "ArchLens"
      },
      {
        "command": "archlens.compareWithScan",
        "title": "Compare with a fresh scan",
        "category": "ArchLens"
      },
      {
        "command": "archlens.copyDiagram",
        "title": "Copy diagram as Mermaid",
        "category": "ArchLens"
      },
      {
        "command": "archlens.showHotspots",
        "title": "Show hotspots",
        "category": "ArchLens"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "archlens.openArchitectureMap",
          "when": "resourceExtname == .yaml || resourceExtname == .yml || resourcePath =~ /blueprints$/",
          "group": "navigation@20"
        },
        {
          "command": "archlens.generateFromWorkspace",
          "when": "explorerResourceIsFolder",
          "group": "navigation@21"
        }
      ],
      "webview/context": [
        {
          "command": "archlens.copyDiagram",
          "when": "webviewId == 'archlens.architectureMap'",
          "group": "navigation@2"
        },
        {
          "command": "archlens.showHotspots",
          "when": "webviewId == 'archlens.architectureMap'",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "ArchLens",
      "properties": {
        "archlens.blueprintsFolder": {
          "type": "string",
          "default": "blueprints",
          "description": "Folder that holds BlueprintSpec files. The preview only reads this folder."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "ArchLens does not read this folder until the workspace is trusted.",
      "restrictedConfigurations": [
        "archlens.blueprintsFolder"
      ]
    }
  },
  "scripts": {
    "compile": "pnpm exec esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package:pre-release": "pnpm run compile && pnpm exec vsce package --pre-release --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "pnpm run compile"
  },
  "dependencies": {
    "@archlens/core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
